{
  "business_name": "Clínica de Estética",
  "own_number": "",
  "chrome": {
    "profile_path": "~/.config/google-chrome",
    "binary": "auto"
  },
  "labels": {
    "include": ["Lead Anuncio", "Repescagem", "Esperando resposta", "Dar retorno"],
    "exclude": ["Agendada", "Consulta paga", "Aguardando pagamento"]
  },
  "filter_mode": "labels",
  "keywords": {
    "include": [
      "valor", "preço", "criodefine", "crio", "consulta",
      "avaliação", "diastase", "agendar", "resultados",
      "como funciona", "quero agendar"
    ],
    "exclude": [
      "agendada com sucesso", "agendado com sucesso",
      "comprovante", "transferência", "pagamento",
      "confirmado", "confirmada"
    ]
  },
  "auto_lead_names": ["anúncio", "anuncio", "ads"],
  "blacklist_names": [],
  "scraper": {
    "max_contacts": null,
    "internal_scrolls": 20
  }
}
